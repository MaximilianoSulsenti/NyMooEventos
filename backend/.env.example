PORT=4000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nymoo?retryWrites=true&w=majority

# Cloudinary (Signed Upload Presets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS (separá varios orígenes con coma, ej. producción + preview de Vercel)
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Emails con permiso para activar/desactivar módulos pagos (separados por coma)
ADMIN_EMAILS=owner@example.com

# Secreto compartido para disparar el backup programado (lo usa el workflow
# de GitHub Actions en .github/workflows/mongo-backup.yml)
BACKUP_SECRET=replace-with-another-long-random-string
